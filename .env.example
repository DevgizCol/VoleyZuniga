# --- Admin (OBLIGATORIAS) ---
# Contraseña del panel /admin. Usa una frase larga y única.
ADMIN_PASSWORD=
# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# --- Cron (OBLIGATORIA si usas vercel.json crons) ---
# Vercel la envía como "Authorization: Bearer <CRON_SECRET>". Sin ella el endpoint responde 401.
CRON_SECRET=

# --- Google Sheets (base de datos gratuita; ver docs/google-sheets/) ---
# URL de la implementación de Apps Script (termina en /exec)
SHEETS_WEBAPP_URL=
# Mismo valor que SHARED_SECRET en las propiedades del script (mínimo 24 caracteres)
SHEETS_SECRET=

# --- Opcionales ---
# Webhook externo para avisos masivos (WhatsApp Cloud API / Evolution / Twilio)
WHATSAPP_WEBHOOK_URL=
# URL pública del sitio (si no usas el dominio por defecto de Vercel)
NEXT_PUBLIC_SITE_URL=
