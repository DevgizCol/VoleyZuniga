# --- Panel /admin (OBLIGATORIAS) ---
# Contraseña del panel /admin. Usa una frase larga y única.
ADMIN_PASSWORD=
# Más usuarios del panel, cada uno con su contraseña (mínimo 8 caracteres), separados por ";".
# El Historial registra el nombre de quien hace cada cambio. Ejemplo:
# ADMIN_USERS=Profe Carlos:una-clave-larga; Equipo técnico:otra-clave-larga
ADMIN_USERS=
# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# --- Google Sheets (base de datos gratuita; ver docs/google-sheets/) ---
# URL de la implementación de Apps Script (termina en /exec)
SHEETS_WEBAPP_URL=
# Mismo valor que SHARED_SECRET en las propiedades del script (mínimo 24 caracteres)
SHEETS_SECRET=

# --- Opcionales ---
# Enlace de la hoja de Google para el botón "Abrir la hoja" del panel
SHEET_URL=
# URL pública del sitio, sin "/" final (si usas un dominio propio)
NEXT_PUBLIC_SITE_URL=
# Códigos de verificación de Google Search Console y Bing Webmaster Tools (solo el valor del atributo content)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
