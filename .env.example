# --- Panel /admin (OBLIGATORIAS) ---
# Usuarios del panel: Nombre:correo:contraseña (mínimo 8 caracteres), separados por ";".
# Entrar pide la contraseña y, la primera vez en cada celular, un código que llega a ese correo.
# El Historial registra el nombre de quien hace cada cambio. Ejemplo:
# ADMIN_USERS=Zúñiga:director@correo.com:una-clave-larga; Contabilidad:conta@correo.com:otra-clave-larga
ADMIN_USERS=
# (Opcional) Usuario "Administrador": contraseña (12+ caracteres) y correo para su código.
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# --- Google Sheets (base de datos gratuita; ver docs/google-sheets/) ---
# URL de la implementación de Apps Script (termina en /exec)
SHEETS_WEBAPP_URL=
# Mismo valor que SHARED_SECRET en las propiedades del script (mínimo 24 caracteres)
SHEETS_SECRET=

# --- Opcionales ---
# Enlace de la hoja de Google para el botón "Abrir la hoja" del panel
SHEET_URL=
# URL pública del sitio, sin "/" final (si usas un dominio propio)
NEXT_PUBLIC_SITE_URL=

# --- Límite de peticiones compartido (opcional, plan gratis de Upstash: 500.000 comandos/mes, sin tarjeta) ---
# Sin estas dos, el límite es solo por instancia (en memoria).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
